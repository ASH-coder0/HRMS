{
  "name": "hospital-hrms-backend",
  "version": "1.0.0",
  "description": "Hospital HRMS backend. Sequelize commands: npx sequelize db:migrate (run migrations), npx sequelize db:seed:all (run seeders).",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "sequelize:migrate": "npx sequelize db:migrate",
    "sequelize:migrate:undo": "npx sequelize db:migrate:undo",
    "sequelize:seed": "npx sequelize db:seed:all",
    "sequelize-cli:install": "npm install -g sequelize-cli"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^7.1.0",
    "joi": "^17.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.6",
    "nepali-date-converter": "^3.4.0",
    "nodemailer": "^6.9.13",
    "react-hot-toast": "^2.6.0",
    "react-to-print": "^3.3.0",
    "sequelize": "^6.37.8",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.5"
  }
}
